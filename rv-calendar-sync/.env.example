# Database
RV_SYNC_DB_PATH=./data/rv_sync.sqlite

# HTTP server
RV_SYNC_HOST=0.0.0.0
RV_SYNC_PORT=8000

# Public base URL of THIS server (used when telling platforms where to fetch our iCal feed)
RV_SYNC_PUBLIC_BASE_URL=https://rv-sync.example.com

# Auth token required to access /api/* endpoints (admin operations)
RV_SYNC_ADMIN_TOKEN=change-me

# Sync interval in minutes (0 = disable scheduler; run via CLI/HTTP instead)
RV_SYNC_INTERVAL_MINUTES=15

# Wix Hotels (only needed if you enable the Wix REST source)
WIX_API_KEY=
WIX_SITE_ID=
WIX_ACCOUNT_ID=
